{
  "name": "relationship-os",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/clean-build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "owner:create": "tsx --env-file-if-exists=.env scripts/create-owner.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "test": "tsx --env-file-if-exists=.env --test tests/*.test.ts",
    "test:integration": "tsx --env-file-if-exists=.env tests/integration.ts",
    "api:generate": "tsx --env-file-if-exists=.env scripts/generate-openapi.ts",
    "maintenance": "tsx --env-file-if-exists=.env scripts/maintenance.ts",
    "monitor": "tsx --env-file-if-exists=.env scripts/monitor.ts",
    "test:performance": "tsx --env-file-if-exists=.env scripts/benchmark.ts",
    "test:recovery": "tsx --env-file-if-exists=.env scripts/test-recovery.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "input-otp": "^1.4.2",
    "jalaali-js": "2.0.1",
    "lucide-react": "^1.31.0",
    "luxon": "^3.7.2",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pg": "8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "yauzl": "^3.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/jalaali-js": "1.2.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "^2.10.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "type": "module"
}
