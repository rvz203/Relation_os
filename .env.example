DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relationship_os
# Generate: openssl rand -hex 32. Retain with encrypted backups.
DATA_ENCRYPTION_KEY=replace_with_64_hex_characters
APP_ORIGIN=http://localhost:3001
SMS_MODE=sandbox
SMS_API_URL=
SMS_API_TOKEN=
SMS_WEBHOOK_SECRET=
# Required only for Docker Compose; use a strong password without URL-reserved characters.
POSTGRES_PASSWORD=
UPLOAD_DIR=./private/uploads

# Optional gateway balance endpoint: GET -> {"balance": number}; uses SMS_API_TOKEN.
SMS_BALANCE_URL=
SMS_LOW_BALANCE_THRESHOLD=10000
SMS_MAX_CHARACTERS=2000
SMS_RETRY_MINUTES=1,5,15
REMINDER_GRACE_HOURS=24
# Optional HTTPS incident receiver; receives only incident codes/owner IDs.
OPS_ALERT_URL=
OPS_ALERT_TOKEN=
