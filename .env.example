DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relationship_os
# Generate: openssl rand -hex 32. Retain with encrypted backups.
DATA_ENCRYPTION_KEY=replace_with_64_hex_characters
APP_ORIGIN=http://localhost:3001
SMS_MODE=sandbox
SMS_API_URL=
SMS_API_TOKEN=
SMS_WEBHOOK_SECRET=
